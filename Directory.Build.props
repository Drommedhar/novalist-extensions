<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Development and release builds use the host SDK checkout beside this repository. -->
  <ItemGroup Condition="'$(UseLocalSdk)' != 'false'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\novalist-official\Novalist.Sdk\Novalist.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalSdk)' == 'false' And '$(NovalistSdkVersion)' != ''">
    <PackageReference Include="Novalist.Sdk" Version="[$(NovalistSdkVersion)]" />
  </ItemGroup>

  <Target Name="RequireExplicitSdkPackageVersion" BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="'$(UseLocalSdk)' == 'false' And '$(NovalistSdkVersion)' == ''">
    <Error Text="Package builds require an exact NovalistSdkVersion from a compatible released host. Use the adjacent updated host source with UseLocalSdk=true while its SDK is unreleased." />
  </Target>
</Project>
